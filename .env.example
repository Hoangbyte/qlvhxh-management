# ==========================================
# CẤU HÌNH SERVER BACKEND
# ==========================================
PORT=8080
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ==========================================
# CẤU HÌNH KẾT NỐI SQL SERVER (CSDL QLVHXH)
# ==========================================
DB_HOST=localhost
DB_PORT=1433
DB_NAME=QLVHXH
DB_USER=sa
DB_PASSWORD=Nhap_Mat_Khau_SQL_Server_Cua_Ban
