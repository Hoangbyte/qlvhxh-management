DB_TRUST_SERVER_CERTIFICATE=true

# ==========================================
# CẤU HÌNH PHIÊN ĐĂNG NHẬP & CHẾ ĐỘ DEMO
# ==========================================
# Khớp với tham số SESSION_TIMEOUT_MIN = 60 trong bảng system_settings
SESSION_TIMEOUT_MIN=60
# 1 = Bật thanh chọn nhanh 9 vai trò khi trình diễn; 0 = Tắt
DEMO_MODE=1